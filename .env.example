# taihoukotobuki-admin 環境変数サンプル
# コピーして .env (ローカル開発用) を作り、実際の値を入れる。
# .env は .gitignore 対象。このファイル(.env.example)自体はプレースホルダーのみなのでコミットしてよい。

# --- Google OAuth (next-auth) ---
# 取得元: Google Cloud Console > APIとサービス > 認証情報 > OAuth 2.0 クライアントID
# ローカル開発なら承認済みリダイレクトURIに http://localhost:3000/api/auth/callback/google を追加する
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ログインを許可するGoogleアカウントのメールアドレス(カンマ区切り、小文字で比較される)
# 例: ALLOWED_EMAILS=you@example.com,teammate@example.com
ALLOWED_EMAILS=

# --- next-auth ---
# ローカル開発時はそのままでよい。本番はデプロイ先のURLに合わせる
NEXTAUTH_URL=http://localhost:3000
# ランダムな秘密鍵。生成コマンド: openssl rand -base64 32
NEXTAUTH_SECRET=

# --- Contentful ---
# 取得元: Contentful管理画面 > Settings > API keys
# Space ID(全トークン共通)
NEXT_PUBLIC_CONTENTFUL_SPACE_ID=
# Content Delivery API - Access Token (読み取り専用、公開ページのブログ表示等で使用。
# NEXT_PUBLIC_ プレフィックスによりクライアントに公開される想定の閲覧専用トークン)
NEXT_PUBLIC_CONTENTFUL_ACCESS_TOKEN=
# Content Management API - Access Token (フル書き込み権限。記事のCRUD・画像アップロードに使用)
# 取得元: Contentful管理画面 > Settings > API keys > Content management tokens
# 【重要】このトークンはサーバー側でのみ使用する。NEXT_PUBLIC_ プレフィックスを付けないこと
# (以前 NEXT_PUBLIC_CONTENTFUL_MANAGEMENT_ACCESS_TOKEN としてクライアントに露出していた問題を修正済み)
CONTENTFUL_MANAGEMENT_ACCESS_TOKEN=
